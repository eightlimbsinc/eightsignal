# ---------------------------------------------------------------------------
# EightSignal environment. Copy to .env.local for development; set the same
# keys in Netlify → Site configuration → Environment variables for production.
# Never commit real values.
# ---------------------------------------------------------------------------

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS; used for scheduled jobs and credential storage.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API (server-only)
ANTHROPIC_API_KEY=
# Optional overrides
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high — depth/cost of impact analysis
ANTHROPIC_EFFORT=medium
AI_ANALYSES_PER_USER_PER_HOUR=30
# Analyse newly ingested records automatically during scheduled runs (true/false)
AUTO_ANALYZE_INGESTED=true

# Public base URL of the deployment (used for auth email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for scheduled jobs calling /api/cron/* (generate: openssl rand -hex 32)
CRON_SECRET=

# Cloudflare credentials
# 32-byte key used to AES-256-GCM encrypt Cloudflare API tokens stored in the database.
# Generate: openssl rand -base64 32   (rotating it invalidates stored tokens)
CLOUDFLARE_CREDENTIALS_KEY=
# Alternatively, keep tokens out of the database entirely and reference them by name
# in Cloudflare Monitor → Setup (storage: "environment variable"). Scoped, read-only
# API tokens only — never a Global API Key.
# CLOUDFLARE_TOKEN_BLEND360=
